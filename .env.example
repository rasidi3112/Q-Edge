# Copy to .env and fill in. Every variable below is read by the code or by
# docker-compose.yml; nothing else is. Never commit .env.
# docker compose loads .env itself; the Python code only reads the process
# environment and does not parse .env.

# --- Server (qedge.server.settings) ---
# Required, at least 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Access token lifetime in seconds (60 to 86400).
JWT_TTL_SECONDS=900
# Issuer of tokens and part of every signed login challenge.
QEDGE_SERVER_ID=qedge
# JSON list. An empty list allows no origins.
CORS_ORIGINS=["http://localhost:3000"]
# true enables uvicorn reload in `qedge-api`.
DEBUG_MODE=false
# Database and blob storage. Without QEDGE_DATABASE_URL the server uses
# SQLite at $QEDGE_DATA_DIR/qedge.db. The Docker image uses /data.
QEDGE_DATA_DIR=qedge-data
QEDGE_DATABASE_URL=
# Submission limits.
QEDGE_MAX_SAMPLES=1000000
# fedavg, median, trimmed_mean, krum, multi_krum or bounded (qedge.fl.robust).
QEDGE_AGGREGATION=fedavg
QEDGE_MAX_UPDATE_BYTES=16777216
# How long an encrypted transport session (and its HELLO id) is kept.
QEDGE_SESSION_TTL_SECONDS=3600
# Polling intervals for round deadlines and the SSE event stream.
QEDGE_DEADLINE_POLL_SECONDS=1.0
QEDGE_EVENTS_POLL_SECONDS=0.5

# --- Crypto (qedge.crypto) ---
# liboqs (default) or pure. pure is pure Python, not constant-time, tests only.
# The server refuses to start if the backend or the key files are missing.
QEDGE_CRYPTO_BACKEND=liboqs
# Directory created by `qedge keys init --dir <path>`. The Docker image uses /keys.
QEDGE_KEY_DIR=
# Prefix holding lib/liboqs.so (or .dylib); read by the liboqs backend and
# liboqs-python. Defaults to ~/_oqs.
OQS_INSTALL_PATH=

# --- Celery (qedge.server.worker) ---
# Used when running outside compose; compose builds these from REDIS_PASSWORD.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- docker-compose.yml only ---
# Required. Use URL-safe characters: they are embedded in connection URLs.
REDIS_PASSWORD=
POSTGRES_PASSWORD=
# Host port for the API, bound to 127.0.0.1.
API_PORT=8000
