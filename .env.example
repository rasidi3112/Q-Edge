# Copy to .env and fill in. Every variable below is read by the code or by
# docker-compose.yml; nothing else is. Never commit .env.
# docker compose loads .env itself; the Python code only reads the process
# environment and does not parse .env.

# --- Server (qedge.server.settings) ---
VQC_NUM_QUBITS=8
VQC_NUM_LAYERS=4
# Queued updates required before /fl/trigger-aggregation runs.
FL_MIN_CLIENTS=1
# JSON list. An empty value allows no origins.
CORS_ORIGINS=["http://localhost:3000"]
# Only echoed in X-RateLimit-* headers; no limit is enforced.
RATE_LIMIT_REQUESTS=100
# true enables uvicorn reload in `qedge-api`.
DEBUG_MODE=false

# --- JWT (qedge.server.auth) ---
# Required by docker-compose.yml. Outside compose the code falls back to a
# hardcoded development secret when this is unset.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# --- Celery (qedge.server.worker) ---
# Used when running outside compose; compose builds these from REDIS_PASSWORD.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- docker-compose.yml only ---
# Required. Use URL-safe characters: it is embedded in redis:// URLs.
REDIS_PASSWORD=
# Host port for the API, bound to 127.0.0.1.
API_PORT=8000
